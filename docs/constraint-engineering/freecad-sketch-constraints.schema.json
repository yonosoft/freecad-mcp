{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad-mcp.local/schemas/freecad-sketch-constraints-v1.json",
  "$comment": "Historical schema retained after agent policy removal.",
  "title": "FreeCAD sketch constraint-engineering policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "compatibility",
    "defaults",
    "phases",
    "rules"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_capabilities"],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_fresh_solver_before_decision",
        "require_fresh_solver_after_mutation",
        "maximum_constraints_per_batch",
        "stop_on_unexpected_dof_effect",
        "stop_on",
        "prohibited_shortcuts"
      ],
      "properties": {
        "require_fresh_solver_before_decision": {"type": "boolean"},
        "require_fresh_solver_after_mutation": {"type": "boolean"},
        "maximum_constraints_per_batch": {"type": "integer", "minimum": 1, "maximum": 100},
        "stop_on_unexpected_dof_effect": {"type": "boolean"},
        "stop_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "prohibited_shortcuts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "dofReduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0, "maximum": 3},
        "maximum": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "phase",
        "priority",
        "preconditions",
        "forbid_when",
        "action",
        "expected_dof_reduction",
        "verification",
        "rationale"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "phase": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0},
        "preconditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbid_when": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["constraint_type"],
          "properties": {
            "constraint_type": {"type": "string", "minLength": 1}
          }
        },
        "expected_dof_reduction": {"$ref": "#/$defs/dofReduction"},
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
